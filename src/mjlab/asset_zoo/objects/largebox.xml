<mujoco model="largebox">
  <compiler meshdir="." />

  <asset>
    <mesh name="largebox_mesh" file="largebox.obj" scale="1 1 1"/>
    <material name="mat" rgba="0.7 0.8 0.9 0.7"/>
  </asset>

  <worldbody>
    <body name="largebox_link" pos="0 0 0">
      <!-- Free joint -->
      <joint name="largebox_freejoint" type="free"/>

      <!-- Inertial properties -->
      <inertial mass="0.1"
                pos="0 0 0"
                fullinertia="0.002 0.002 0.002 0 0 0"/>


      <geom name="largebox_geom"
						type="mesh"
						mesh="largebox_mesh"
						material="mat"
						friction="0.8 0.5 0.01"
						contype="1"
						conaffinity="1"
						solimp="0.9 0.95 0.001"
						solref="0.02 1"/>
    </body>
  </worldbody>
</mujoco>
